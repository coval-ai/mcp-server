{
  "name": "@coval/mcp-server",
  "version": "0.3.0",
  "description": "Coval MCP Server - AI evaluation platform integration for Claude Desktop, Cursor, and other MCP clients",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "coval-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/remote.js",
    "inspector": "npx @modelcontextprotocol/inspector",
    "check:remote": "node scripts/check-remote.mjs",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "npm test -- --testPathPattern=unit",
    "test:e2e": "npm test -- --testPathPattern=e2e",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "coval",
    "mcp",
    "model-context-protocol",
    "ai",
    "claude",
    "evaluation",
    "testing",
    "voice-ai"
  ],
  "author": {
    "name": "Coval",
    "url": "https://coval.dev"
  },
  "homepage": "https://github.com/coval-ai/mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coval-ai/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/coval-ai/mcp-server/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@clerk/express": "^2.1.39",
    "@clerk/mcp-tools": "^0.5.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.14.2",
    "@types/aws-lambda": "^8.10.159",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
