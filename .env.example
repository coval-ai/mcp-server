# Coval MCP Server Environment Variables

# Required for testing (use staging API key)
COVAL_API_KEY=your_staging_api_key_here

# Optional: Override API base URL (default: https://api.coval.dev/v1)
# COVAL_API_BASE_URL=https://api.coval.dev/v1

# Optional: Log level (default: info)
# LOG_LEVEL=debug
